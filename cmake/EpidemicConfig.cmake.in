@PACKAGE_INIT@
set(Epidemic_VERSION "@PROJECT_VERSION@")
set(Epidemic_ABI_VERSION @EPIDEMIC_ABI_VERSION@)
set(Epidemic_BUILD_ID "@EPIDEMIC_BUILD_ID@")
if(DEFINED EPIDEMIC_REQUIRED_ABI AND NOT EPIDEMIC_REQUIRED_ABI STREQUAL "${Epidemic_ABI_VERSION}")
    message(FATAL_ERROR "Epidemic ABI mismatch: required ${EPIDEMIC_REQUIRED_ABI}, installed ${Epidemic_ABI_VERSION}")
endif()
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "This Epidemic SDK requires Windows x64")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/EpidemicTargets.cmake")
foreach(_component Presentation Session)
    set(Epidemic_${_component}_FOUND FALSE)
    if(TARGET Epidemic::EpidemicGameFramework${_component})
        set(Epidemic_${_component}_FOUND TRUE)
    endif()
endforeach()
check_required_components(Epidemic)
